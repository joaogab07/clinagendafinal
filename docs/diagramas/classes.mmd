classDiagram
    direction LR
    class Usuario {
        -int id
        -str nome
        -str login
        -str senhaHash
        -str perfil
        -int pacienteId
        +is_admin() bool
        +is_paciente() bool
        +is_equipe() bool
        +login_valido(login)$ bool
        +validar_cadastro(nome, login, senha, confirmacao)$ list
        +validar_nova_senha(senha, confirmacao)$ list
    }
    class Especialidade {
        -int id
        -str nome
        -str descricao
        +validar() list
    }
    class Profissional {
        -int id
        -str nome
        -str registro
        -str telefone
        -str email
        -bool ativo
        +validar() list
    }
    class Paciente {
        -int id
        -str nome
        -str cpf
        -date dataNascimento
        -str telefone
        -str email
        -str endereco
        +validar() list
    }
    class Consulta {
        -int id
        -datetime dataHora
        -int duracaoMin
        -StatusConsulta status
        -str observacoes
        +inicio() datetime
        +fim() datetime
        +conflita_com(outra: Consulta) bool
        +validar(nova: bool) list
    }
    class StatusConsulta {
        <<enumeration>>
        AGENDADA
        REALIZADA
        CANCELADA
    }
    Especialidade "1" <-- "0..*" Profissional : pertence a
    Profissional "1" <-- "0..*" Consulta : atendida por
    Paciente "1" <-- "0..*" Consulta : de
    Usuario "1" <-- "0..*" Consulta : registrada por
    Usuario "0..1" --> "0..1" Paciente : conta do
    Consulta ..> StatusConsulta
